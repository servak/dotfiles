{
  "$schema": "https://raw.githubusercontent.com/manaflow-ai/cmux/main/web/data/cmux.schema.json",
  "schemaVersion": 1,

  // cmux-only settings migrated from config/wezterm.
  // Fonts, colors, split styling and keybinds (Ctrl-t leader) live in config/ghostty/config,
  // which cmux reads as well. Reload both with `cmux reload-config` or Cmd+Shift+,.
  //
  // cmux is used as a plain terminal multiplexer with a markdown/browser pane;
  // the AI/agent features below are turned off.

  "app": {
    // WezTerm: window_close_confirmation = "NeverPrompt"
    "warnBeforeClosingWindow": false,
    "warnBeforeClosingAgentSession": false
  },

  "terminal": {
    // WezTerm: enable_scroll_bar = false
    "showScrollBar": false,
    "autoResumeAgentSessions": false
  },

  "sidebar": {
    // WezTerm tab_title.lua showed only the last segment of the cwd
    "pathLastSegmentOnly": true,
    "showAgentActivity": false,
    "showAgentUsage": false
  },

  // Chief (Home row and the agent that drives workspaces)
  "chief": {
    "enabled": false
  },

  "agentMessages": {
    "enabled": false
  },

  "computerUse": {
    "enabled": false
  },

  // Do not wrap agent CLIs (claude, codex, ...) with cmux hooks.
  // Settings UI writes automation.*Integration; integrations.*.hooksEnabled is the canonical form.
  "automation": {
    "claudeCodeIntegration": false,
    "codexIntegration": false,
    "piIntegration": false,
    "ampIntegration": false,
    "cursorIntegration": false,
    "geminiIntegration": false,
    "kiroIntegration": false,
    "agentAutoResume": false
  },

  "integrations": {
    "claudeCode": { "hooksEnabled": false },
    "codex": { "hooksEnabled": false },
    "pi": { "hooksEnabled": false },
    "amp": { "hooksEnabled": false },
    "cursor": { "hooksEnabled": false },
    "gemini": { "hooksEnabled": false },
    "kiro": { "hooksEnabled": false }
  },

  "notifications": {
    "agentPermissionPrompt": false,
    "agentTurnComplete": "never",
    "agentIdleReminder": false
  },

  "shortcuts": {
    "bindings": {
      // WezTerm: Ctrl+Shift+X activated copy mode (vi keys: v / V / y / "/" / n / { } / q).
      // Ghostty has no copy-mode action, so it cannot sit under the Ctrl-t leader;
      // a cmux chord on ctrl+t would swallow the whole Ghostty leader table.
      "toggleTerminalCopyMode": "ctrl+shift+x"
    }
  }
}
