#!/usr/bin/env python3
"""Markdown をターミナルの右に開いて、保存したら表示を更新する。

    mdview <file.md>

- iTerm2 の中: 今のペインを右に分割し、ブラウザペインで表示する
  （Homebrew cask "itermbrowserplugin" が必要。Markdown と Mermaid は
  ページ内の markdown-it / mermaid.js で描画する。ライブラリは CDN から読む）
- それ以外: glow のページャで開く

iTerm2 では mdview はペインに表示されたままキーを待つ。
    q / Ctrl-C  表示も閉じて終わる
    z           表示を残して終わる（以後は更新しない）
    e           $EDITOR で開く。閉じるとまたキー待ちに戻る

iTerm2 のブラウザペインは file:// のページから隣のファイルを fetch できないが、
<script src> での読み込みはできる。そこで Markdown を data.js に書き出し、
ページが1秒ごとに読み直す。data.js を書き直すのは mdview 自身だけで、
裏に残るプロセスは作らない。
"""

import hashlib
import json
import os
import select
import shlex
import shutil
import signal
import subprocess
import sys
import termios
import time
import tty

CACHE_DIR = os.path.expanduser("~/Library/Caches/mdview")
VIEWS_DIR = os.path.join(CACHE_DIR, "views")
DYNAMIC_PROFILE_PATH = os.path.expanduser(
    "~/Library/Application Support/iTerm2/DynamicProfiles/mdview.json"
)
PROFILE_NAME = "mdview"
PROFILE_GUID = "dotfiles-mdview-browser"
POLL_INTERVAL_SEC = 0.5
SESSION_CHECK_INTERVAL_SEC = 5
# z で残した表示のファイルは、次に mdview を開いたときにこれより古ければ消す
STALE_VIEW_SEC = 24 * 60 * 60

# iTerm2 のプロファイルは開く URL が固定なので、いったん launch.html を開き、
# launch.js に書かれた表示ページへ移動する。
LAUNCH_HTML = """<!doctype html>
<meta charset="utf-8">
<script>
const s = document.createElement("script");
s.src = "launch.js?t=" + Date.now();
s.onload = () => location.replace(window.__mdviewNext);
document.head.appendChild(s);
</script>
"""

VIEW_HTML = """<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>mdview</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/github-markdown-css@5.8.1/github-markdown-light.min.css">
<script src="https://cdn.jsdelivr.net/npm/markdown-it@14.1.0/dist/markdown-it.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/mermaid@11.4.1/dist/mermaid.min.js"></script>
<style>
  body { margin: 0; background: #fff; }
  .markdown-body { box-sizing: border-box; max-width: 980px; margin: 0 auto; padding: 24px 32px; }
  .markdown-body pre.mermaid { background: transparent; text-align: center; }
</style>
</head>
<body>
<article id="content" class="markdown-body"></article>
<script>
const md = markdownit({ html: false, linkify: true });
const defaultFence = md.renderer.rules.fence;
md.renderer.rules.fence = (tokens, idx, options, env, self) => {
  const token = tokens[idx];
  if (token.info.trim() === "mermaid") {
    return '<pre class="mermaid">' + md.utils.escapeHtml(token.content) + "</pre>";
  }
  return defaultFence(tokens, idx, options, env, self);
};
mermaid.initialize({ startOnLoad: false, theme: "default" });

let rev = null;
let timer = null;

async function render(data) {
  document.title = data.title;
  // 描き直しでスクロール位置が飛ばないよう、描画前の位置に戻す
  const y = window.scrollY;
  const content = document.getElementById("content");
  content.innerHTML = md.render(data.text);
  try {
    await mermaid.run({ nodes: content.querySelectorAll("pre.mermaid") });
  } catch (e) {
    console.error(e);
  }
  window.scrollTo(0, y);
}

function poll() {
  const s = document.createElement("script");
  s.src = "data.js?t=" + Date.now();
  s.onload = () => {
    s.remove();
    const data = window.__mdview;
    if (!data) return;
    if (data.rev !== rev) {
      rev = data.rev;
      render(data);
    }
    // mdview が終わったら（z で残したとき）読み直しもやめる
    if (data.final) clearInterval(timer);
  };
  s.onerror = () => s.remove();
  document.head.appendChild(s);
}

poll();
timer = setInterval(poll, 1000);
</script>
</body>
</html>
"""

# 今のペインを右に分割してブラウザペインを開き、そのセッション ID を返す
SPLIT_SCRIPT = """
on run argv
  set targetId to item 1 of argv
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        if (id of sessions of t) contains targetId then
          -- ループ変数の参照のまま split すると応答が返らないことがあるので、ID で指し直す
          set s to session id targetId of t
          tell s to set newSession to (split vertically with profile "%s")
          tell s to select
          return id of newSession
        end if
      end repeat
    end repeat
  end tell
  error "session not found: " & targetId
end run
""" % PROFILE_NAME

SESSION_EXISTS_SCRIPT = """
on run argv
  set targetId to item 1 of argv
  if application "iTerm2" is not running then return "no"
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        if (id of sessions of t) contains targetId then return "yes"
      end repeat
    end repeat
  end tell
  return "no"
end run
"""

CLOSE_SESSION_SCRIPT = """
on run argv
  set targetId to item 1 of argv
  if application "iTerm2" is not running then return
  tell application "iTerm2"
    repeat with w in windows
      repeat with t in tabs of w
        if (id of sessions of t) contains targetId then
          tell (session id targetId of t) to close
          return
        end if
      end repeat
    end repeat
  end tell
end run
"""

KEY_HELP = "q:閉じる  z:残して終了  e:編集"


class Hangup(Exception):
    """端末が閉じられた（SIGHUP / SIGTERM を受けた）ことを表す。"""


def write_atomic(path, content):
    """一時ファイルに書いてから置き換え、読み込み途中のファイルを見せない。"""
    tmp_path = path + ".tmp"
    with open(tmp_path, "w", encoding="utf-8") as f:
        f.write(content)
    os.replace(tmp_path, path)


def ensure_dynamic_profile():
    """ブラウザ用の Dynamic Profile を用意する。新しく書いたときは True を返す。"""
    profile = {
        "Profiles": [
            {
                "Name": PROFILE_NAME,
                "Guid": PROFILE_GUID,
                "Custom Command": "Browser",
                "Initial URL": "file://" + os.path.join(CACHE_DIR, "launch.html"),
            }
        ]
    }
    content = json.dumps(profile, indent=2) + "\n"
    try:
        with open(DYNAMIC_PROFILE_PATH, encoding="utf-8") as f:
            if f.read() == content:
                return False
    except FileNotFoundError:
        pass
    os.makedirs(os.path.dirname(DYNAMIC_PROFILE_PATH), exist_ok=True)
    write_atomic(DYNAMIC_PROFILE_PATH, content)
    return True


def remove_stale_views():
    """z で残した古い表示のファイルを消す。"""
    try:
        names = os.listdir(VIEWS_DIR)
    except FileNotFoundError:
        return
    now = time.time()
    for name in names:
        path = os.path.join(VIEWS_DIR, name)
        try:
            if now - os.stat(path).st_mtime > STALE_VIEW_SEC:
                shutil.rmtree(path, ignore_errors=True)
        except FileNotFoundError:
            pass


def osascript(script, *args):
    """AppleScript を実行して標準出力を返す。"""
    result = subprocess.run(
        ["osascript", "-", *args],
        input=script,
        capture_output=True,
        text=True,
        check=True,
    )
    return result.stdout.strip()


class View:
    """ブラウザペイン1つ分の表示と、その元になる Markdown を受け持つ。"""

    def __init__(self, md_path):
        """表示用のファイルを置くディレクトリを決める。"""
        self.md_path = md_path
        view_id = hashlib.sha1((md_path + str(time.time())).encode()).hexdigest()[:12]
        self.view_id = view_id
        self.dir = os.path.join(VIEWS_DIR, view_id)
        self.session_id = None
        self.last_mtime = None
        self.revision = 0
        self.updated_at = None

    def prepare(self):
        """表示ページと最初の data.js を書き出す。"""
        os.makedirs(self.dir, exist_ok=True)
        write_atomic(os.path.join(CACHE_DIR, "launch.html"), LAUNCH_HTML)
        write_atomic(os.path.join(self.dir, "index.html"), VIEW_HTML)
        self.refresh()
        write_atomic(
            os.path.join(CACHE_DIR, "launch.js"),
            "window.__mdviewNext = "
            + json.dumps("views/%s/index.html" % self.view_id)
            + ";\n",
        )

    def write_data(self, final=False):
        """Markdown を読み、ページが読み込む data.js を書き出す。"""
        with open(self.md_path, encoding="utf-8", errors="replace") as f:
            text = f.read()
        data = {
            "rev": hashlib.sha1(text.encode("utf-8")).hexdigest(),
            "title": os.path.basename(self.md_path),
            "text": text,
            "final": final,
        }
        write_atomic(
            os.path.join(self.dir, "data.js"),
            "window.__mdview = " + json.dumps(data, ensure_ascii=False) + ";\n",
        )

    def refresh(self):
        """Markdown が保存されていたら data.js を書き直す。書き直したら True。"""
        try:
            mtime = os.stat(self.md_path).st_mtime_ns
        except FileNotFoundError:
            # エディタが保存時にファイルを置き換える間は一瞬消える
            return False
        if mtime == self.last_mtime:
            return False
        self.last_mtime = mtime
        self.write_data()
        self.revision += 1
        self.updated_at = time.strftime("%H:%M:%S")
        return True

    def open_pane(self, session_id):
        """iTerm2 のペインを右に分割して表示する。"""
        if ensure_dynamic_profile():
            # iTerm2 が Dynamic Profile を読み込むまで待つ
            time.sleep(2)
        self.session_id = osascript(SPLIT_SCRIPT, session_id)

    def pane_exists(self):
        """表示しているペインがまだあるか調べる。"""
        try:
            return osascript(SESSION_EXISTS_SCRIPT, self.session_id) == "yes"
        except subprocess.CalledProcessError:
            return False

    def close(self):
        """ペインを閉じて表示用のファイルを消す。"""
        if self.session_id:
            try:
                osascript(CLOSE_SESSION_SCRIPT, self.session_id)
            except subprocess.CalledProcessError:
                pass
        shutil.rmtree(self.dir, ignore_errors=True)

    def detach(self):
        """表示を残し、ページの読み直しを止める。"""
        try:
            self.write_data(final=True)
        except FileNotFoundError:
            pass


def show_status(view):
    """今のペインに状態とキーの説明を1行で出す。"""
    line = "mdview: %s  版 %d (%s)  %s" % (
        os.path.basename(view.md_path),
        view.revision,
        view.updated_at or "-",
        KEY_HELP,
    )
    sys.stdout.write("\r\033[K" + line)
    sys.stdout.flush()


def clear_status():
    """状態の行を消す。"""
    sys.stdout.write("\r\033[K")
    sys.stdout.flush()


def run_editor(view):
    """$EDITOR で Markdown を開き、閉じるまで保存のたびに表示を更新する。"""
    editor = shlex.split(os.environ.get("EDITOR") or "vim")
    # Ctrl-C はエディタに任せ、mdview は止めない。子プロセスには既定の動作に戻して渡す
    previous = signal.signal(signal.SIGINT, signal.SIG_IGN)
    try:
        proc = subprocess.Popen(
            editor + [view.md_path],
            preexec_fn=lambda: signal.signal(signal.SIGINT, signal.SIG_DFL),
        )
        while proc.poll() is None:
            view.refresh()
            time.sleep(POLL_INTERVAL_SEC)
        view.refresh()
    except FileNotFoundError:
        sys.stdout.write("mdview: エディタを起動できませんでした: %s\n" % editor[0])
    finally:
        signal.signal(signal.SIGINT, previous)


def wait_keys(view):
    """キーを待ちながら表示を更新する。押されたキー（q か z）を返す。"""
    fd = sys.stdin.fileno()
    saved = termios.tcgetattr(fd)
    last_session_check = time.monotonic()
    try:
        tty.setcbreak(fd)
        show_status(view)
        while True:
            ready, _, _ = select.select([fd], [], [], POLL_INTERVAL_SEC)
            if ready:
                key = os.read(fd, 1).decode(errors="ignore")
                if key in ("q", "\x03"):
                    return "q"
                if key == "z":
                    return "z"
                if key == "e":
                    termios.tcsetattr(fd, termios.TCSADRAIN, saved)
                    clear_status()
                    run_editor(view)
                    tty.setcbreak(fd)
                    last_session_check = time.monotonic()
                show_status(view)
                continue
            if view.refresh():
                show_status(view)
            if time.monotonic() - last_session_check >= SESSION_CHECK_INTERVAL_SEC:
                last_session_check = time.monotonic()
                if not view.pane_exists():
                    # 表示のペインが手で閉じられた
                    return "closed"
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, saved)
        clear_status()


def raise_hangup(signum, frame):
    """端末が閉じられたら後片付けへ進む。"""
    raise Hangup()


def open_in_iterm(md_path):
    """今の iTerm2 ペインを右に分割して表示し、キーを待つ。"""
    if not sys.stdin.isatty():
        print("mdview: 端末から実行してください", file=sys.stderr)
        return 1
    session_id = os.environ["ITERM_SESSION_ID"].split(":", 1)[-1]
    remove_stale_views()
    view = View(md_path)
    view.prepare()
    try:
        view.open_pane(session_id)
    except subprocess.CalledProcessError as e:
        view.close()
        print("mdview: iTerm2 のペインを開けませんでした: " + e.stderr.strip(), file=sys.stderr)
        return 1

    signal.signal(signal.SIGHUP, raise_hangup)
    signal.signal(signal.SIGTERM, raise_hangup)
    action = "q"
    try:
        action = wait_keys(view)
    except (KeyboardInterrupt, Hangup):
        action = "q"
    finally:
        if action == "z":
            view.detach()
        else:
            view.close()
    return 0


def main():
    """引数を確かめ、動いている端末に合わせて開き方を選ぶ。"""
    if len(sys.argv) != 2:
        print("usage: mdview <file>", file=sys.stderr)
        return 1
    md_path = os.path.abspath(sys.argv[1])
    if not os.path.isfile(md_path):
        print("mdview: %s が見つかりません" % sys.argv[1], file=sys.stderr)
        return 1

    if os.environ.get("TERM_PROGRAM") == "iTerm.app" and os.environ.get("ITERM_SESSION_ID"):
        return open_in_iterm(md_path)
    os.execvp("glow", ["glow", "-p", md_path])


if __name__ == "__main__":
    sys.exit(main())
