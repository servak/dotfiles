#!/usr/bin/env -S uv run --script --quiet
# /// script
# requires-python = ">=3.11"
# dependencies = ["ruamel.yaml>=0.18"]
# ///
"""secrets - YAML で定義したプロファイルの環境変数を 1Password (op) から解決して出力する.

設定ファイル: $SECRETS_FILE または ${XDG_CONFIG_HOME:-~/.config}/secrets/secrets.yaml

    version: 1
    default_profile: app1               # profile を省略したときに使う（省略時は default）

    secrets:                            # 秘密の一覧。定義はここに 1 回だけ書く
      notion:
        ref: op://Private/Notion/password
        description: Notion integration
      cloudflare: op://Private/Cloudflare/api-token     # 文字列 op://... は ref の省略形
      db_url:
        template: "postgres://app:{{ op://Private/DB/password }}@db/app"

    profiles:                           # アプリ・用途ごとに必要な変数を選ぶ
      base:
        env:
          NOTION_TOKEN: notion          # 一覧の名前で参照する
      app1:
        description: App1 の実行に必要
        include: [base]                 # 他プロファイルの変数を取り込む（後勝ち）
        env:
          CF_API_TOKEN: cloudflare
          GH_TOKEN: op://Work/GitHub/token              # その場で定義してもよい
          LOG_LEVEL: {value: debug}                     # リテラル（op を通さない）

取り出し元は ref / template / value のいずれか 1 つ。
値を現在のシェルに読み込むのは zsh / fish の `secrets` 関数（load / unload）で、
この CLI は `export` で各シェル・言語向けの形式を標準出力に書くだけ。
show / list などは参照先しか表示せず、解決した値は export と run 以外では出さない。
"""

from __future__ import annotations

import argparse
import json
import os
import re
import secrets as _secrets
import shlex
import subprocess
import sys
import tempfile
from dataclasses import dataclass, field
from pathlib import Path

from ruamel.yaml import YAML
from ruamel.yaml.comments import CommentedMap, CommentedSeq
from ruamel.yaml.error import YAMLError

CONFIG_VERSION = 1
KEY_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*$")
NAME_RE = re.compile(r"^[A-Za-z0-9][A-Za-z0-9_.-]*$")
SOURCES = ("ref", "template", "value")
TOP_LEVEL = ("version", "default_profile", "secrets", "profiles")
FORMATS = ("sh", "bash", "zsh", "fish", "json", "dotenv")
LOADED_VAR = "SECRETS_LOADED"


class SecretsError(Exception):
    """利用者に見せるエラー（スタックトレースを出さずにメッセージだけ表示する）."""


# --------------------------------------------------------------------------- 設定


LEGACY_DIR = Path("~/.zsh/secrets").expanduser()  # 旧 <profile>.env と旧 secrets.yaml の置き場所
EXAMPLE = Path(__file__).resolve().parent.parent / "secrets" / "examples" / "secrets.yaml.example"


def config_path() -> Path:
    """設定ファイルのパスを返す."""
    if os.environ.get("SECRETS_FILE"):
        return Path(os.environ["SECRETS_FILE"]).expanduser()
    base = Path(os.environ.get("XDG_CONFIG_HOME") or "~/.config").expanduser()
    return base / "secrets" / "secrets.yaml"


def ensure_parent(path: Path) -> None:
    """設定ファイルのディレクトリを本人だけが読める権限で作る."""
    if not path.parent.exists():
        path.parent.mkdir(parents=True, mode=0o700)


def new_yaml() -> YAML:
    """コメントと順序を保ったまま読み書きする YAML インスタンスを作る."""
    yaml = YAML()
    yaml.indent(mapping=2, sequence=4, offset=2)
    yaml.preserve_quotes = True
    yaml.width = 4096
    return yaml


def empty_config() -> CommentedMap:
    """空の設定を作る."""
    data = CommentedMap()
    data["version"] = CONFIG_VERSION
    data["secrets"] = CommentedMap()
    data["profiles"] = CommentedMap()
    return data


def load_config(path: Path | None = None, *, must_exist: bool = True) -> CommentedMap:
    """設定ファイルを読み、トップレベルの形を確認して返す."""
    path = path or config_path()
    if not path.exists():
        if not must_exist:
            return empty_config()
        hint = "create it with 'secrets edit' or 'secrets profile add <name>'"
        old = LEGACY_DIR / "secrets.yaml"
        if old.exists() and not os.environ.get("SECRETS_FILE"):
            hint = f"found the old location; move it with: mkdir -p -m 700 {path.parent} && mv {old} {path}"
        elif list(LEGACY_DIR.glob("*.env")):
            hint = "old .env profiles found; convert them with 'secrets migrate'"
        raise SecretsError(f"config not found: {path}\n{hint}")
    try:
        data = new_yaml().load(path.read_text())
    except YAMLError as e:
        raise SecretsError(f"failed to parse {path}:\n{e}") from e
    if data is None:
        data = empty_config()
    if not isinstance(data, dict):
        raise SecretsError(f"{path}: top level must be a mapping")
    version = data.get("version", CONFIG_VERSION)
    if version != CONFIG_VERSION:
        raise SecretsError(f"{path}: unsupported config version: {version}")
    if "defaults" in data:
        raise SecretsError(f"{path}: 'defaults' is no longer supported; write full op:// references")
    unknown = set(map(str, data)) - set(TOP_LEVEL)
    if unknown:
        raise SecretsError(f"{path}: unknown top-level field(s): {', '.join(sorted(unknown))}")
    for section in ("secrets", "profiles"):
        if section not in data and section == "secrets" and "profiles" in data:
            # 読みやすさのため、一覧はプロファイルより前に置く
            data.insert(list(data).index("profiles"), "secrets", CommentedMap())
        if data.get(section) is None:
            data[section] = CommentedMap()
        if not isinstance(data[section], dict):
            raise SecretsError(f"{path}: '{section}' must be a mapping")
    return data


def save_config(data: CommentedMap, path: Path | None = None) -> None:
    """設定ファイルをパーミッション 600 で原子的に書き込む."""
    path = path or config_path()
    ensure_parent(path)
    fd, tmp = tempfile.mkstemp(prefix=".secrets.", suffix=".yaml", dir=path.parent)
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w") as f:
            new_yaml().dump(data, f)
        os.replace(tmp, path)
    except BaseException:
        Path(tmp).unlink(missing_ok=True)
        raise


def default_profile(data: CommentedMap) -> str:
    """profile を省略したときに使うプロファイル名."""
    return str(data.get("default_profile") or "default")


# --------------------------------------------------------------------------- 解決


@dataclass
class Source:
    """値の取り出し元."""

    kind: str  # ref | template | value
    text: str  # op:// 参照 / テンプレート / リテラル値
    description: str = ""


@dataclass
class Var:
    """プロファイル内の 1 つの環境変数."""

    key: str
    source: Source
    secret: str = ""  # 秘密の一覧から参照している場合はその名前
    description: str = ""
    origin: str = ""  # 定義しているプロファイル（include 元を示す）


@dataclass
class Profile:
    """include を展開したプロファイル."""

    name: str
    description: str = ""
    vars: dict[str, Var] = field(default_factory=dict)


def as_list(value) -> list:
    """スカラーなら 1 要素のリストにする."""
    if value is None:
        return []
    if isinstance(value, (list, tuple)):
        return list(value)
    return [value]


def scalar_text(value) -> str:
    """YAML のスカラーを文字列にする（true/false は小文字のまま）."""
    return str(value).lower() if isinstance(value, bool) else str(value)


def parse_source(where: str, spec) -> Source:
    """ref / template / value のどれか 1 つを持つ定義を検証して Source にする."""
    if isinstance(spec, str) and spec.startswith("op://"):
        return Source("ref", spec)
    if not isinstance(spec, dict):
        raise SecretsError(f"{where}: must be an op:// string or a mapping with one of {' / '.join(SOURCES)}")
    unknown = set(map(str, spec)) - set(SOURCES) - {"description"}
    if unknown:
        raise SecretsError(f"{where}: unknown field(s): {', '.join(sorted(unknown))}")
    present = [s for s in SOURCES if s in spec]
    if len(present) != 1:
        raise SecretsError(f"{where}: exactly one of {' / '.join(SOURCES)} is required")
    kind = present[0]
    text = scalar_text(spec[kind])
    if kind == "ref" and not text.startswith("op://"):
        raise SecretsError(f"{where}: ref must start with op://")
    if kind == "template" and "{{" not in text:
        raise SecretsError(f"{where}: template must contain a {{{{ op://... }}}} reference")
    return Source(kind, text, str(spec.get("description") or ""))


def catalog(data: CommentedMap) -> dict[str, Source]:
    """秘密の一覧を検証して 名前 => Source を返す."""
    result = {}
    for name, spec in data["secrets"].items():
        name = str(name)
        if not NAME_RE.match(name):
            raise SecretsError(f"secrets: invalid secret name: {name}")
        result[name] = parse_source(f"secrets.{name}", spec)
    return result


def parse_var(data: CommentedMap, profile: str, key: str, spec) -> Var:
    """env の 1 エントリを Var にする（文字列は op:// 参照か一覧の名前）."""
    where = f"{profile}.{key}"
    if not KEY_RE.match(key):
        raise SecretsError(f"{profile}: invalid variable name: {key}")
    if isinstance(spec, str) and not spec.startswith("op://"):
        secrets = catalog(data)
        if spec not in secrets:
            raise SecretsError(f"{where}: secret not found: {spec} (add it with 'secrets secret add {spec} op://...')")
        src = secrets[spec]
        return Var(key, src, secret=spec, description=src.description, origin=profile)
    src = parse_source(where, spec)
    return Var(key, src, description=src.description, origin=profile)


def resolve_profile(data: CommentedMap, name: str, stack: tuple[str, ...] = ()) -> Profile:
    """include を再帰的に展開し、後から定義したものを優先して Profile を返す."""
    if name in stack:
        raise SecretsError("include cycle: " + " -> ".join((*stack, name)))
    profiles = data["profiles"]
    if name not in profiles:
        raise SecretsError(f"profile not found: {name} (in {config_path()})")
    spec = profiles[name] or {}
    if not isinstance(spec, dict):
        raise SecretsError(f"{name}: profile must be a mapping")
    unknown = set(map(str, spec)) - {"description", "include", "env"}
    if unknown:
        raise SecretsError(f"{name}: unknown field(s): {', '.join(sorted(unknown))}")

    result = Profile(name, str(spec.get("description") or ""))
    for inc in as_list(spec.get("include")):
        result.vars.update(resolve_profile(data, str(inc), (*stack, name)).vars)

    env = spec.get("env") or {}
    if not isinstance(env, dict):
        raise SecretsError(f"{name}: env must be a mapping")
    for key, value in env.items():
        result.vars.pop(str(key), None)  # 上書きした変数は末尾に並べる
        result.vars[str(key)] = parse_var(data, name, str(key), value)
    return result


def resolve_many(data: CommentedMap, names: list[str]) -> dict[str, Var]:
    """複数プロファイルを順に重ねた変数定義を返す（空なら default_profile）."""
    merged: dict[str, Var] = {}
    for name in names or [default_profile(data)]:
        for key, var in resolve_profile(data, name).vars.items():
            merged.pop(key, None)
            merged[key] = var
    return merged


def secrets_token() -> str:
    """op inject の出力を分割する目印に使う乱数."""
    return _secrets.token_hex(8)


def fetch_values(variables: dict[str, Var]) -> dict[str, str]:
    """op inject を 1 回だけ呼んで ref / template を解決し、KEY => 値 を返す."""
    values = {k: v.source.text for k, v in variables.items() if v.source.kind == "value"}
    pending = {k: v.source for k, v in variables.items() if v.source.kind != "value"}
    if pending:
        # 値の前後に毎回乱数入りの目印を挟み、改行を含む値でも分割できるようにする。
        # op inject は制御文字を落とすので、目印は印字可能な文字だけで作る。
        nonce = secrets_token()
        mark = lambda name: f"<<secrets:{nonce}:{name}>>"  # noqa: E731
        template = "".join(
            mark(k) + (f"{{{{ {s.text} }}}}" if s.kind == "ref" else s.text)
            for k, s in pending.items()
        ) + mark("END")
        try:
            proc = subprocess.run(
                ["op", "inject"], input=template, capture_output=True, text=True, check=False
            )
        except FileNotFoundError as e:
            raise SecretsError("1Password CLI 'op' is not installed") from e
        if proc.returncode != 0:
            raise SecretsError("op inject failed:\n" + proc.stderr.strip())
        body, found, _ = proc.stdout.partition(mark("END"))
        if not found:
            raise SecretsError("unexpected output from op inject (end marker missing)")
        parts = re.split(re.escape(f"<<secrets:{nonce}:") + r"([A-Za-z_][A-Za-z0-9_]*)>>", body)
        for key, value in zip(parts[1::2], parts[2::2]):
            values[key] = value
        missing = set(pending) - set(values)
        if missing:
            raise SecretsError("op inject returned no value for: " + ", ".join(sorted(missing)))
    return {k: values[k] for k in variables}  # 定義順に並べ直す


# --------------------------------------------------------------------------- 出力形式


def sh_quote(value: str) -> str:
    """POSIX sh / bash / zsh 用にシングルクォートで囲む."""
    return "'" + value.replace("'", "'\\''") + "'"


def fish_quote(value: str) -> str:
    """fish 用にシングルクォートで囲む（\\ と ' だけをエスケープする）."""
    return "'" + value.replace("\\", "\\\\").replace("'", "\\'") + "'"


def dotenv_quote(value: str) -> str:
    """dotenv 用にダブルクォートで囲む（改行は \\n にする）."""
    escaped = (
        value.replace("\\", "\\\\").replace('"', '\\"').replace("$", "\\$").replace("\n", "\\n")
    )
    return f'"{escaped}"'


def loaded_profiles() -> list[str]:
    """現在のシェルで読み込み済みのプロファイル名."""
    return os.environ.get(LOADED_VAR, "").split()


def render_set(fmt: str, values: dict[str, str], loaded: list[str] | None) -> str:
    """変数を設定するスクリプト / データを fmt の形式で返す."""
    if fmt == "json":
        return json.dumps(values, ensure_ascii=False, indent=2) + "\n"
    if fmt == "dotenv":
        return "".join(f"{k}={dotenv_quote(v)}\n" for k, v in values.items())
    if loaded is not None:
        values = {**values, LOADED_VAR: " ".join(loaded)}
    if fmt == "fish":
        return "".join(f"set -gx {k} {fish_quote(v)}\n" for k, v in values.items())
    return "".join(f"export {k}={sh_quote(v)}\n" for k, v in values.items())


def render_unset(fmt: str, keys: list[str], loaded: list[str] | None) -> str:
    """変数を消すスクリプトを fmt の形式で返す."""
    if fmt not in ("sh", "bash", "zsh", "fish"):
        raise SecretsError(f"--unset is not supported for format: {fmt}")
    lines = []
    if fmt == "fish":
        lines += [f"set -e {k}" for k in keys]
        if loaded is not None:
            lines.append(f"set -gx {LOADED_VAR} {fish_quote(' '.join(loaded))}" if loaded else f"set -e {LOADED_VAR}")
    else:
        if keys:
            lines.append("unset " + " ".join(keys))
        if loaded is not None:
            lines.append(f"export {LOADED_VAR}={sh_quote(' '.join(loaded))}" if loaded else f"unset {LOADED_VAR}")
    return "".join(line + "\n" for line in lines)


# --------------------------------------------------------------------------- 表示


def info(msg: str) -> None:
    """状態メッセージを標準エラーへ出す."""
    print(f"secrets: {msg}", file=sys.stderr)


def describe_source(src: Source) -> str:
    """値を含まない取り出し元の説明を返す."""
    if src.kind == "ref":
        return src.text
    return "template" if src.kind == "template" else "literal"


def secret_users(data: CommentedMap) -> dict[str, list[str]]:
    """秘密の名前 => それを env で直接参照している "profile.KEY" の一覧."""
    users: dict[str, list[str]] = {}
    for pname, spec in data["profiles"].items():
        env = (spec or {}).get("env") if isinstance(spec, dict) else None
        for key, value in (env or {}).items():
            if isinstance(value, str) and not value.startswith("op://"):
                users.setdefault(value, []).append(f"{pname}.{key}")
    return users


# --------------------------------------------------------------------------- サブコマンド


def cmd_list(args: argparse.Namespace) -> int:
    """プロファイル一覧を表示する."""
    data = load_config()
    names = [str(n) for n in data["profiles"]]
    if args.names:
        print("\n".join(names))
        return 0
    if not names:
        raise SecretsError(f"no profiles in {config_path()} (try 'secrets profile add default')")
    loaded = set(loaded_profiles())
    default = default_profile(data)
    status = 0
    labels = {n: f"{n} (default)" if n == default and len(names) > 1 else n for n in names}
    width = max(12, *map(len, labels.values()))
    for name in names:
        try:
            prof = resolve_profile(data, name)
        except SecretsError as e:
            info(str(e))
            status = 1
            continue
        mark = "*" if name in loaded else " "
        desc = f"  # {prof.description}" if prof.description else ""
        print(f"{mark} {labels[name]:<{width}} {', '.join(prof.vars)}{desc}")
    return status


def cmd_show(args: argparse.Namespace) -> int:
    """変数名・設定状況・参照先・説明を表示する（値は表示しない）."""
    data = load_config()
    if args.keys:
        print("\n".join(resolve_many(data, args.profiles)))
        return 0
    for name in args.profiles or [default_profile(data)]:
        prof = resolve_profile(data, name)
        print(f"# {name}" + (f": {prof.description}" if prof.description else ""))
        for var in prof.vars.values():
            state = "set" if var.key in os.environ else "-"
            src = describe_source(var.source)
            if var.secret:
                src = f"{var.secret} -> {src}"
            origin = f" (from {var.origin})" if var.origin != name else ""
            print(f"{var.key:<24} {state:<4} {src:<44} {var.description}{origin}".rstrip())
    return 0


def cmd_check(args: argparse.Namespace) -> int:
    """秘密の一覧と全プロファイルを検証する（op は呼ばない）."""
    data = load_config()
    bad = 0
    try:
        secrets = catalog(data)
        print(f"ok  secrets ({len(secrets)} defined)")
    except SecretsError as e:
        info(str(e))
        bad += 1
    for name in map(str, data["profiles"]):
        try:
            prof = resolve_profile(data, name)
            print(f"ok  {name} ({len(prof.vars)} vars)")
        except SecretsError as e:
            info(str(e))
            bad += 1
    default = default_profile(data)
    if data.get("default_profile") and default not in data["profiles"]:
        info(f"default_profile not found: {default}")
        bad += 1
    if not bad:
        unused = sorted(set(map(str, data["secrets"])) - set(secret_users(data)))
        if unused:
            info(f"unused secrets: {', '.join(unused)}")
    return 1 if bad else 0


def cmd_export(args: argparse.Namespace) -> int:
    """プロファイルの変数を指定形式で標準出力に書く."""
    fmt = args.format
    track = fmt in ("sh", "bash", "zsh", "fish") and not args.no_track
    data = load_config()
    if args.unset:
        names = args.profiles or loaded_profiles()
        if not names:
            info("nothing loaded")
            return 0
        keys = list(resolve_many(data, names))
        loaded = [n for n in loaded_profiles() if n not in names] if track else None
        sys.stdout.write(render_unset(fmt, keys, loaded))
        if args.verbose:
            info(f"unloaded {' '.join(names)} ({', '.join(keys)})")
        return 0

    names = args.profiles or [default_profile(data)]
    variables = resolve_many(data, names)
    if not variables:
        raise SecretsError(f"no variables in profile {' '.join(names)}")
    values = fetch_values(variables)
    loaded = None
    if track:
        loaded = loaded_profiles()
        loaded += [n for n in names if n not in loaded]
    sys.stdout.write(render_set(fmt, values, loaded))
    if args.verbose:
        info(f"loaded {' '.join(names)} ({', '.join(values)})")
    return 0


def cmd_run(args: argparse.Namespace) -> int:
    """プロファイルの変数を付けてコマンドを実行する（現在のシェルには残らない）."""
    if not args.command:
        raise SecretsError("usage: secrets run [profile...] -- command [args...]")
    data = load_config()
    values = fetch_values(resolve_many(data, args.profiles))
    try:
        os.execvpe(args.command[0], args.command, {**os.environ, **values})
    except FileNotFoundError as e:
        raise SecretsError(f"command not found: {args.command[0]}") from e
    return 127  # 到達しない


def cmd_edit(args: argparse.Namespace) -> int:
    """設定ファイルを $EDITOR で開き、閉じたら検証する."""
    path = config_path()
    if not path.exists():
        if EXAMPLE.exists():
            ensure_parent(path)
            path.write_text(EXAMPLE.read_text())
            path.chmod(0o600)
        else:
            save_config(empty_config())
    editor = shlex.split(os.environ.get("EDITOR", "vim"))
    if subprocess.run([*editor, str(path)], check=False).returncode != 0:
        return 1
    return cmd_check(args)


def build_source(args: argparse.Namespace, *, allow_name: bool):
    """add 系コマンドの SOURCE 引数を YAML に書く値にする.

    allow_name が真なら、op:// でも --template / --literal でもない文字列を
    秘密の一覧の名前として扱う（その場合は文字列をそのまま返す）。
    """
    src = args.source
    if args.literal or args.template:
        kind = "value" if args.literal else "template"
    elif src.startswith("op://"):
        kind = "ref"
    elif allow_name:
        if args.description:
            raise SecretsError("-d cannot be used with a secret name; set the description on the secret")
        return src
    else:
        # 本物の秘密を平文で書き込む事故を防ぐため、リテラルは明示させる
        raise SecretsError("source is not an op:// reference; use --literal (stored as plain text) or --template")
    if kind == "ref" and not args.description:
        return src
    spec = CommentedMap()
    spec[kind] = src
    if args.description:
        spec["description"] = args.description
    return spec


def cmd_profile_add(args: argparse.Namespace) -> int:
    """プロファイルを追加する."""
    data = load_config(must_exist=False)
    profiles = data["profiles"]
    if not NAME_RE.match(args.name):
        raise SecretsError(f"invalid profile name: {args.name}")
    if args.name in profiles:
        raise SecretsError(f"profile already exists: {args.name}")
    for inc in args.include:
        if inc not in profiles:
            raise SecretsError(f"include target not found: {inc}")
    spec = CommentedMap()
    if args.description:
        spec["description"] = args.description
    if args.include:
        seq = CommentedSeq(args.include)
        seq.fa.set_flow_style()
        spec["include"] = seq
    spec["env"] = CommentedMap()
    profiles[args.name] = spec
    save_config(data)
    info(f"added profile {args.name}")
    return 0


def cmd_profile_rm(args: argparse.Namespace) -> int:
    """プロファイルを削除する（他から include されていれば拒否）."""
    data = load_config()
    profiles = data["profiles"]
    if args.name not in profiles:
        raise SecretsError(f"profile not found: {args.name}")
    users = [
        str(n) for n, spec in profiles.items()
        if isinstance(spec, dict) and args.name in map(str, as_list(spec.get("include")))
    ]
    if users and not args.force:
        raise SecretsError(f"{args.name} is included by: {', '.join(users)} (use --force)")
    del profiles[args.name]
    save_config(data)
    info(f"removed profile {args.name}")
    return 0


def cmd_secret_list(args: argparse.Namespace) -> int:
    """秘密の一覧と、それを使っているプロファイルを表示する."""
    data = load_config()
    secrets = catalog(data)
    if args.names:
        print("\n".join(secrets))
        return 0
    users = secret_users(data)
    for name, src in secrets.items():
        used = ", ".join(users.get(name, [])) or "(unused)"
        print(f"{name:<16} {describe_source(src):<44} {src.description}".rstrip())
        print(f"{'':<16} used by: {used}")
    return 0


def cmd_secret_where(args: argparse.Namespace) -> int:
    """秘密を参照している profile.KEY を表示する."""
    data = load_config()
    if args.name not in catalog(data):
        raise SecretsError(f"secret not found: {args.name}")
    for user in secret_users(data).get(args.name, []):
        print(user)
    return 0


def cmd_secret_add(args: argparse.Namespace) -> int:
    """秘密の一覧に追加する（--force で上書き）."""
    if not NAME_RE.match(args.name):
        raise SecretsError(f"invalid secret name: {args.name}")
    data = load_config(must_exist=False)
    if args.name in data["secrets"] and not args.force:
        raise SecretsError(f"secret already exists: {args.name} (use --force to overwrite)")
    data["secrets"][args.name] = build_source(args, allow_name=False)
    catalog(data)  # 書き込む前に検証する
    save_config(data)
    info(f"added secret {args.name}")
    return 0


def cmd_secret_rm(args: argparse.Namespace) -> int:
    """秘密の一覧から削除する（使われていれば拒否）."""
    data = load_config()
    if args.name not in data["secrets"]:
        raise SecretsError(f"secret not found: {args.name}")
    users = secret_users(data).get(args.name, [])
    if users and not args.force:
        raise SecretsError(f"{args.name} is used by: {', '.join(users)} (use --force)")
    del data["secrets"][args.name]
    save_config(data)
    info(f"removed secret {args.name}")
    return 0


def cmd_env_add(args: argparse.Namespace) -> int:
    """プロファイルに変数を追加する（--force で上書き）."""
    if not KEY_RE.match(args.key):
        raise SecretsError(f"invalid variable name: {args.key}")
    data = load_config()
    profiles = data["profiles"]
    if args.profile not in profiles:
        raise SecretsError(f"profile not found: {args.profile} (create it with 'secrets profile add {args.profile}')")
    pspec = profiles[args.profile]
    if pspec is None:
        pspec = profiles[args.profile] = CommentedMap()
    if pspec.get("env") is None:
        pspec["env"] = CommentedMap()
    env = pspec["env"]
    if args.key in env and not args.force:
        raise SecretsError(f"{args.profile}.{args.key} already exists (use --force to overwrite)")
    env[args.key] = build_source(args, allow_name=True)
    resolve_profile(data, args.profile)  # 書き込む前に検証して、壊れた設定を保存しない
    save_config(data)
    info(f"set {args.profile}.{args.key}")
    return 0


def cmd_env_rm(args: argparse.Namespace) -> int:
    """プロファイルから変数を削除する."""
    data = load_config()
    if args.profile not in data["profiles"]:
        raise SecretsError(f"profile not found: {args.profile}")
    env = (data["profiles"][args.profile] or {}).get("env") or {}
    if args.key not in env:
        raise SecretsError(f"{args.profile}.{args.key} not found")
    del env[args.key]
    save_config(data)
    info(f"removed {args.profile}.{args.key}")
    return 0


ENV_LINE_RE = re.compile(r"^\s*(?:export\s+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$")
INJECT_ONLY_RE = re.compile(r"^\{\{\s*(op://\S+?)\s*\}\}$")


def parse_env_file(path: Path) -> dict[str, str]:
    """旧形式 <profile>.env を KEY => 値 にする."""
    result: dict[str, str] = {}
    for line in path.read_text().splitlines():
        m = ENV_LINE_RE.match(line)
        if not m:
            continue
        value = m.group(2).strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            value = value[1:-1]
        result[m.group(1)] = value
    return result


def cmd_migrate(args: argparse.Namespace) -> int:
    """旧形式 <dir>/*.env を YAML 設定へ変換する（各変数はプロファイル内に直接定義）."""
    src_dir = Path(args.source_dir).expanduser()
    files = sorted(src_dir.glob("*.env"))
    if not files:
        raise SecretsError(f"no .env profiles in {src_dir}")
    path = config_path()
    if path.exists() and not args.force:
        raise SecretsError(f"{path} already exists (use 'secrets migrate --force' to overwrite)")
    data = empty_config()
    for file in files:
        env = CommentedMap()
        for key, value in parse_env_file(file).items():
            m = INJECT_ONLY_RE.match(value)
            if m:
                value = m.group(1)
            if value.startswith("op://"):
                env[key] = value
            elif "{{" in value and "}}" in value:
                env[key] = CommentedMap(template=value)
            else:
                env[key] = CommentedMap(value=value)
        data["profiles"][file.stem] = CommentedMap(env=env)
        resolve_profile(data, file.stem)
        info(f"migrated {file.stem} ({', '.join(env)})")
    save_config(data, path)
    info(f"wrote {path}")
    home = str(Path.home())
    info("old files were left as is; remove them after checking: "
         + " ".join(str(f).replace(home, "~", 1) for f in files))
    return 0


# --------------------------------------------------------------------------- CLI


def add_source_args(p: argparse.ArgumentParser) -> None:
    """add 系コマンド共通の SOURCE 関連オプション."""
    kind = p.add_mutually_exclusive_group()
    kind.add_argument("--template", action="store_true", help="SOURCE is an op inject template")
    kind.add_argument("--literal", action="store_true", help="SOURCE is stored as plain text")
    p.add_argument("-d", "--description")
    p.add_argument("-f", "--force", action="store_true", help="overwrite an existing entry")


def build_parser() -> argparse.ArgumentParser:
    """引数パーサを組み立てる."""
    p = argparse.ArgumentParser(
        prog="secrets",
        description="1Password-backed environment profiles defined in YAML.",
        epilog=f"config: {config_path()}  (override with SECRETS_FILE). "
        "profile defaults to default_profile in the config, or 'default'.",
    )
    sub = p.add_subparsers(dest="cmd", metavar="<command>")

    s = sub.add_parser("list", aliases=["ls"], help="list profiles (* = loaded in this shell)")
    s.add_argument("--names", action="store_true", help="print profile names only")
    s.set_defaults(func=cmd_list)

    s = sub.add_parser("show", help="show variables and their sources (never values)")
    s.add_argument("profiles", nargs="*")
    s.add_argument("--keys", action="store_true", help="print variable names only")
    s.set_defaults(func=cmd_show)

    s = sub.add_parser("check", help="validate the config without calling op")
    s.set_defaults(func=cmd_check)

    s = sub.add_parser("export", help="resolve and print variables for a shell or language")
    s.add_argument("profiles", nargs="*", help="profiles to merge in order")
    s.add_argument("-f", "--format", choices=FORMATS, default="sh")
    s.add_argument("--unset", action="store_true", help="print commands that unset the variables")
    s.add_argument("--no-track", action="store_true", help=f"do not update {LOADED_VAR}")
    s.add_argument("-v", "--verbose", action="store_true", help="print loaded / unloaded variable names to stderr")
    s.set_defaults(func=cmd_export)

    s = sub.add_parser(
        "run", help="run a command with the variables set",
        usage="secrets run [profile...] -- command [args...]",
    )
    s.add_argument("profiles", nargs="*", help="profiles before '--'")
    s.set_defaults(func=cmd_run, command=[])

    s = sub.add_parser("edit", help="open the config in $EDITOR and validate it")
    s.set_defaults(func=cmd_edit)

    s = sub.add_parser("migrate", help="convert old <profile>.env files into the YAML config")
    s.add_argument("-f", "--force", action="store_true", help="overwrite an existing config")
    s.add_argument("--from", dest="source_dir", default=str(LEGACY_DIR), help=f"directory of .env files (default: {LEGACY_DIR})")
    s.set_defaults(func=cmd_migrate)

    prof = sub.add_parser("profile", help="add / remove profiles")
    psub = prof.add_subparsers(dest="profile_cmd", metavar="<action>", required=True)
    s = psub.add_parser("add", help="add a profile")
    s.add_argument("name")
    s.add_argument("-d", "--description")
    s.add_argument("-i", "--include", action="append", default=[], help="profile to include (repeatable)")
    s.set_defaults(func=cmd_profile_add)
    s = psub.add_parser("rm", help="remove a profile")
    s.add_argument("name")
    s.add_argument("-f", "--force", action="store_true", help="remove even if other profiles include it")
    s.set_defaults(func=cmd_profile_rm)

    sec = sub.add_parser("secret", help="manage the shared list of secrets")
    ssub = sec.add_subparsers(dest="secret_cmd", metavar="<action>", required=True)
    s = ssub.add_parser("list", aliases=["ls"], help="list secrets and where they are used")
    s.add_argument("--names", action="store_true", help="print secret names only")
    s.set_defaults(func=cmd_secret_list)
    s = ssub.add_parser(
        "add", help="add a secret",
        description="SOURCE is an op:// reference. Use --template for a string with "
        "{{ op://... }}, or --literal for a plain-text value.",
    )
    s.add_argument("name")
    s.add_argument("source")
    add_source_args(s)
    s.set_defaults(func=cmd_secret_add)
    s = ssub.add_parser("rm", help="remove a secret")
    s.add_argument("name")
    s.add_argument("-f", "--force", action="store_true", help="remove even if profiles use it")
    s.set_defaults(func=cmd_secret_rm)
    s = ssub.add_parser("where", help="show profile.KEY entries that use a secret")
    s.add_argument("name")
    s.set_defaults(func=cmd_secret_where)

    env = sub.add_parser("env", help="add / remove variables in a profile")
    esub = env.add_subparsers(dest="env_cmd", metavar="<action>", required=True)
    s = esub.add_parser(
        "add", help="add a variable to a profile",
        description="SOURCE is a secret name from 'secrets secret list', or an op:// reference. "
        "Use --template / --literal to define it in place.",
    )
    s.add_argument("profile")
    s.add_argument("key")
    s.add_argument("source")
    add_source_args(s)
    s.set_defaults(func=cmd_env_add)
    s = esub.add_parser("rm", help="remove a variable from a profile")
    s.add_argument("profile")
    s.add_argument("key")
    s.set_defaults(func=cmd_env_rm)
    return p


def main(argv: list[str] | None = None) -> int:
    """エントリポイント."""
    parser = build_parser()
    argv = sys.argv[1:] if argv is None else argv
    command: list[str] = []
    if argv[:1] == ["run"] and "--" in argv:
        # argparse は -- 以降の扱いが不安定なので、run のコマンド部分は先に切り出す
        i = argv.index("--")
        argv, command = argv[:i], argv[i + 1:]
    args = parser.parse_args(argv)
    if not getattr(args, "func", None):
        parser.print_help()
        return 0
    if args.func is cmd_run:
        args.command = command
    try:
        return args.func(args)
    except SecretsError as e:
        info(str(e))
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
