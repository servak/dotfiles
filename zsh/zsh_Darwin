eval $(/opt/homebrew/bin/brew shellenv)

alias -s {png,jpg,bmp,PNG,JPG,BMP}='open -a Preview'
alias tac='tail -r'

alias sha256sum='gsha256sum'
alias gls='gls --color'

alias sed="gsed"
alias ghp="gh pr create --web"  # k=kubectl は zsh-abbr で定義
export PYTHONDONTWRITEBYTECODE=1
code () { open -n -b "com.microsoft.VSCode" --args $(realpath "$*") }
export PATH=~/.zsh/bin/Darwin:$PATH

eval "$(mise activate zsh)"

# Modern CLI tools (replace common commands on Mac)
alias ls='gls -F'
# ll は eza。ファイル名の色は LS_COLORS（dir_colors）、それ以外の列は EZA_COLORS で灰色に抑える。
# 並びは古い順（新しいファイルが一番下、これまでの ls -ltr と同じ）
export EZA_COLORS='ur=38;5;245:uw=38;5;245:ux=38;5;245:ue=38;5;245:gr=38;5;245:gw=38;5;245:gx=38;5;245:tr=38;5;245:tw=38;5;245:tx=38;5;245:su=38;5;245:sf=38;5;245:xa=38;5;245:sn=38;5;252:sb=38;5;245:uu=38;5;245:un=38;5;245:gu=38;5;245:gn=38;5;245:da=38;5;245:lc=38;5;245:lm=38;5;245:hd=38;5;245:ga=38;2;127;191;127:gm=38;2;240;230;140:gd=38;2;208;113;111:gv=38;2;127;191;255:gt=38;2;180;160;230:gi=38;5;240'
alias ll="eza -lF --sort=modified --git --icons --time-style='+%Y-%m-%d %H:%M'"
alias la='ll -a'
alias tree='eza --tree --color=auto'
alias exa='eza --group-directories-first --color=auto'  # 別名で使用
