# Copy to ~/.config/secrets/secrets.yaml (or run `secrets edit`) and replace with your own 1Password references.
# Load with `secrets load [profile]`, validate with `secrets check`. See ../README.md for all commands.
version: 1
default_profile: default # used when no profile is given (defaults to "default")

# Shared list of secrets. Define each one once and reference it by name from profiles.
secrets:
  notion:
    ref: op://Private/Notion/password
    description: Notion integration
  cloudflare: op://Private/Cloudflare/api-token # a plain op:// string is shorthand for ref
  github:
    ref: op://Work/GitHub/token
    description: GitHub PAT
  db_url:
    template: "postgres://app:{{ op://Work/DB/password }}@db.internal/app"

# Profiles pick the variables an app / context needs.
profiles:
  default:
    description: Personal API tokens
    env:
      NOTION_TOKEN: notion # name from `secrets`
      CLOUDFLARE_API_TOKEN: cloudflare

  app1:
    description: Variables App1 needs
    include: [default] # later definitions override included ones
    env:
      GITHUB_TOKEN: github
      DATABASE_URL: db_url
      SENTRY_DSN: op://Work/Sentry/dsn # defined in place, not shared
      AWS_REGION:
        value: ap-northeast-1 # literal, not sent to op
