#compdef secrets
local -a profiles cmds
profiles=(${(f)"$(command secrets list --names 2>/dev/null)"})

if (( CURRENT == 2 )); then
    cmds=(
        'list:プロファイル一覧'
        'show:変数名・参照先・説明を表示'
        'load:プロファイルを読み込んで export'
        'unload:読み込んだ変数を unset'
        'export:各シェル・言語向けの形式で出力'
        'run:変数を付けてコマンドを実行'
        'profile:プロファイルの追加・削除'
        'secret:秘密の一覧を管理'
        'env:プロファイルの変数を追加・削除'
        'check:設定ファイルを検証'
        'edit:設定ファイルを編集'
        'migrate:旧形式 .env を YAML へ変換'
        'help:ヘルプを表示'
    )
    _describe 'command' cmds
    return
fi

case $words[2] in
    unload) compadd -- ${=SECRETS_LOADED} ;;
    show|load) compadd -a profiles ;;
    export)
        if [[ $words[CURRENT-1] == (-f|--format) ]]; then
            compadd sh bash zsh fish json dotenv
        else
            compadd -a profiles; compadd -- --format --unset --verbose
        fi
        ;;
    run) compadd -a profiles; compadd -- -- ;;
    profile)
        if (( CURRENT == 3 )); then compadd add rm
        elif [[ $words[3] == rm ]] || [[ $words[CURRENT-1] == (-i|--include) ]]; then compadd -a profiles
        fi
        ;;
    secret)
        if (( CURRENT == 3 )); then compadd list add rm where
        elif (( CURRENT == 4 )) && [[ $words[3] == (rm|where) ]]; then
            compadd -- ${(f)"$(command secrets secret list --names 2>/dev/null)"}
        fi
        ;;
    env)
        if (( CURRENT == 3 )); then compadd add rm
        elif (( CURRENT == 4 )); then compadd -a profiles
        elif (( CURRENT == 5 )) && [[ $words[3] == rm ]]; then
            compadd -- ${(f)"$(command secrets show --keys $words[4] 2>/dev/null)"}
        elif (( CURRENT == 6 )) && [[ $words[3] == add ]]; then
            compadd -- ${(f)"$(command secrets secret list --names 2>/dev/null)"}
        fi
        ;;
    migrate) compadd -- --force ;;
esac
