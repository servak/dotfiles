#compdef secrets
local -a profiles=(${SECRETS_DIR:-$HOME/.zsh/secrets}/*.env(N:t:r))

if (( CURRENT == 2 )); then
    local -a cmds=(
        'list:プロファイル一覧'
        'show:変数名と op:// 参照を表示'
        'load:プロファイルを読み込んで export'
        'unload:読み込んだ変数を unset'
        'edit:プロファイルを編集'
        'help:ヘルプを表示'
    )
    _describe 'command' cmds
elif (( CURRENT == 3 )); then
    case $words[2] in
        unload) compadd -a _secrets_loaded ;;
        show|load|edit) compadd -a profiles ;;
    esac
fi
