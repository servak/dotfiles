# secrets - 1Password 参照テンプレートから環境変数を読み込む / 管理する
# プロファイル: ${SECRETS_DIR:-~/.zsh/secrets}/<name>.env （1 行 1 変数）
#   NOTION_TOKEN=op://Private/FamilyTree/password   # op:// 参照は op inject で解決
#   FOO="{{ op://Vault/Item/field }}"               # op inject 形式もそのまま使える
#   LOG_LEVEL=debug                                 # それ以外はリテラル値
# 環境変数を現在のシェルへ export するため、外部コマンドではなく関数として実装している。
local dir=${SECRETS_DIR:-$HOME/.zsh/secrets}
local cmd=${1:-help}
(( $# )) && shift

# 読み込み済みプロファイル（list の表示と unload の既定対象に使う）
typeset -gaU _secrets_loaded

# プロファイルを読み、keys（順序保持）と vals（KEY => 値）を呼び出し元のローカル変数に詰める
__secrets_parse() {
    local line k v
    keys=() vals=()
    while IFS= read -r line || [[ -n $line ]]; do
        [[ $line =~ '^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$' ]] || continue
        k=$match[2] v=$match[3]
        v=${v##[[:space:]]#} v=${v%%[[:space:]]#}
        if [[ $v == \"*\" || $v == \'*\' ]]; then
            v=${v[2,-2]}
        fi
        keys+=$k
        vals[$k]=$v
    done < $1
}

__secrets_file() {
    local file=$dir/${1:-default}.env
    if [[ ! -f $file ]]; then
        print -u2 "secrets: profile not found: $file"
        print -u2 "create it with 'secrets edit ${1:-default}' (examples: $dir/examples/)"
        return 1
    fi
    print -r -- $file
}

local file name k
local -a keys
local -A vals
case $cmd in
    list|ls)
        local -a files=($dir/*.env(N))
        if (( ! $#files )); then
            print -u2 "secrets: no profiles in $dir (try 'secrets edit default')"
            return 1
        fi
        for file in $files; do
            name=${file:t:r}
            __secrets_parse $file
            printf '%1s %-12s %s\n' "${${_secrets_loaded[(Ie)$name]:#0}:+*}" $name "${(j:, :)keys}"
        done
        ;;
    show)
        file=$(__secrets_file $1) || return 1
        __secrets_parse $file
        for k in $keys; do
            printf '%-24s %-4s %s\n' $k "${${parameters[$k]:+set}:--}" $vals[$k]
        done
        ;;
    load)
        if ! command -v op >/dev/null; then
            print -u2 "secrets: 1Password CLI 'op' is not installed"
            return 1
        fi
        name=${1:-default}
        file=$(__secrets_file $name) || return 1
        __secrets_parse $file
        (( $#keys )) || { print -u2 "secrets: no variables in $file"; return 1 }

        local -a tmpl
        local v
        for k in $keys; do
            v=$vals[$k]
            [[ $v == op://* ]] && v="{{ $v }}"
            tmpl+="$k=$v"
        done

        local out
        out=$(print -rl -- $tmpl | op inject) || { print -u2 "secrets: op inject failed"; return 1 }

        # op inject の出力は "KEY=値" の行。値に改行を含むシークレットは非対応
        local line
        for line in ${(f)out}; do
            export "${line%%=*}=${line#*=}"
        done
        _secrets_loaded+=$name
        print -u2 "secrets: loaded $name (${(j:, :)keys})"
        ;;
    unload)
        local -a names=($@)
        (( $#names )) || names=($_secrets_loaded)
        (( $#names )) || { print -u2 "secrets: nothing loaded"; return 0 }
        for name in $names; do
            file=$(__secrets_file $name) || return 1
            __secrets_parse $file
            unset $keys
            _secrets_loaded=(${_secrets_loaded:#$name})
            print -u2 "secrets: unloaded $name (${(j:, :)keys})"
        done
        ;;
    edit)
        file=$dir/${1:-default}.env
        if [[ ! -f $file ]]; then
            mkdir -p $dir
            print -r -- "# KEY=op://Vault/Item/field" > $file
        fi
        ${=EDITOR:-vim} $file
        ;;
    help|-h|--help)
        cat <<EOF
usage: secrets <command> [profile]

commands:
  list               プロファイル一覧（* は読み込み済み）
  show   [profile]   変数名と op:// 参照を表示（値は表示しない）
  load   [profile]   op inject で解決して現在のシェルに export
  unload [profile]   読み込んだ変数を unset（省略時は読み込み済み全て）
  edit   [profile]   プロファイルを \$EDITOR で開く（無ければ作成）

profile の既定値は default。ファイルは $dir/<profile>.env
EOF
        ;;
    *)
        print -u2 "secrets: unknown command: $cmd (see 'secrets help')"
        return 1
        ;;
esac
