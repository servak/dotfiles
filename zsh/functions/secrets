# secrets - zsh 用ラッパー。本体は ~/.zsh/bin/secrets（Python + uv）
# load / unload は現在のシェルの環境変数を変えるため、本体の export 出力を eval する。
# それ以外のサブコマンドはそのまま本体に渡す。
case $1 in
    load)
        shift
        local out
        out=$(command secrets export --verbose --format zsh "$@") || return 1
        eval "$out"
        ;;
    unload)
        shift
        local out
        out=$(command secrets export --verbose --format zsh --unset "$@") || return 1
        eval "$out"
        ;;
    help|-h|--help|'')
        command secrets --help
        print -r -- "
shell commands (zsh / fish function):
  load   [profile...]  resolve with op and export into the current shell
  unload [profile...]  unset variables (default: every loaded profile)"
        ;;
    *)
        command secrets "$@"
        ;;
esac
