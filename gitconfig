[color]
	ui = auto
	status = always
[include]
	path = ~/.gitconfig.local
[core]
	excludesfile = ~/.gitignore
	editor = vim
[pull]
	rebase = true
[alias]
	co = checkout
	st = status
	ci = commit -a
	d  = diff
	dc = diff --cached
	br = branch
	s  = status --short --branch
	rv = remote --verbose
	graph = log --graph --date=short --decorate=short --pretty=format:'%C(red)%h %C(reset)-%C(yellow)%d %Creset%s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
	graphall = log --graph --all --abbrev-commit --date=relative --pretty=format:'%C(red)%h %C(reset)-%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset'
	delete-merged-branch = !git branch --merged | grep -v master | grep -v '*' | xargs -I % git branch -d %
[merge]
	tool = vimdiff
# 差分は delta で表示する。delta がない環境（Linux サーバーなど）では diff-highlight に戻す
[pager]
	show = "if command -v delta >/dev/null 2>&1; then delta; else diff-highlight | less -R; fi"
	diff = "if command -v delta >/dev/null 2>&1; then delta; else diff-highlight | less -R; fi"
	log = "if command -v delta >/dev/null 2>&1; then delta; else less -R; fi"
[delta]
	navigate = true
	line-numbers = true
	# 色は控えめに: コードの色付けは落ち着いたテーマ、追加・削除の背景は薄く
	syntax-theme = OneHalfDark
	minus-style = syntax "#4a2c2c"
	minus-emph-style = syntax "#6e3a3a"
	plus-style = syntax "#2c4a32"
	plus-emph-style = syntax "#3a6e44"
	file-style = "#80ebdf"
	file-decoration-style = "#80ebdf" ul
	hunk-header-style = file line-number "#7a7a7a"
	hunk-header-file-style = "#80ebdf"
	hunk-header-line-number-style = "#a0a0a0"
	hunk-header-decoration-style = "#4a4a4a" box
	line-numbers-minus-style = "#d0716f"
	line-numbers-plus-style = "#7fbf7f"
	line-numbers-zero-style = "#5a5a5a"
[push]
	default = current
[credential]
	helper = store
[ghq]
	root = ~/ghq
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
[format]
	signoff = true
